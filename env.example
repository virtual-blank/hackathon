# ---------- Postgres ----------
# POSTGRES_HOST/PORT нужны только для запуска backend на хосте (make run);
# в Docker их переопределяет compose (postgres:5432).
POSTGRES_USER="takt_usr"
POSTGRES_PASSWORD="change_me"
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT=5435
POSTGRES_NAME="takt_db"

# ---------- JWT ----------
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7d
JWT_SECRET_KEY="change_me_long_random_string"
JWT_ALGORITHM="HS256"

# ---------- MinIO ----------
# MINIO_HOST/MINIO_ENDPOINT нужны только при запуске backend на хосте;
# в Docker их переопределяет compose (minio:9000).
MINIO_HOST="127.0.0.1"
MINIO_PORT=9000
MINIO_ROOT_USER="minio_admin"
MINIO_ROOT_PASSWORD="change_me"
MINIO_BUCKET_NAME="pfps"
MINIO_ENDPOINT="http://localhost:9000"
# Адрес, по которому МИНИО открывает БРАУЗЕР (попадает в pfp_url).
# Локально: http://localhost:9000. На сервере: https://ваш-домен
MINIO_PUBLIC_URL="http://localhost:9000"

# ---------- Telegram (локально лучше оставить заглушки) ----------
TELEGRAM_BOT_TOKEN="123456:local-placeholder"
TELEGRAM_BOT_NAME="local_bot"
TELEGRAM_LINK_TTL_MINUTES=15
# ПУСТО локально! Если задан, backend при старте перенаправит webhook бота на этот адрес.
TELEGRAM_WEBHOOK_URL=""

# ---------- Демо-данные (fill_db.py) ----------
SYNTHETIC_USER_1_USERNAME="alexandra_sfm"
SYNTHETIC_USER_1_PASSWORD="change_me"
SYNTHETIC_USER_1_EMAIL="alexandra@sfm.com"

SYNTHETIC_USER_2_USERNAME="dima_kolesnikov"
SYNTHETIC_USER_2_PASSWORD="change_me"
SYNTHETIC_USER_2_EMAIL="dima@example.com"

# ---------- Frontend ----------
# Локально только с вашего компьютера, порт 8080 (80 часто занят).
FRONTEND_BIND="127.0.0.1"
FRONTEND_PORT="8080"
